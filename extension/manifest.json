{
  "manifest_version": 3,
  "name": "WalletLens: Net Worth & Portfolio Tracker",
  "short_name": "WalletLens",
  "version": "1.5.3",
  "description": "Your whole net worth in your toolbar: crypto, stocks, gold, property, cash. AI screenshot and voice import. Free, no account.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WalletLens Portfolio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://walletlens.live/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://walletlens.live/*",
    "https://api.coingecko.com/*",
    "https://api.alternative.me/*",
    "https://walletlens-voice.tarek-abdelhameed.workers.dev/*",
    "https://stooq.com/*",
    "https://api.gold-api.com/*",
    "https://open.er-api.com/*"
  ]
}
