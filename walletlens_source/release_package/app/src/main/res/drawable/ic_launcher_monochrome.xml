<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome layer for the launcher icon (Android 13+ themed icons).

    The platform throws away every colour here and tints the alpha, exactly as
    it does with a notification badge — so this is the mark alone: the lens
    ring, three bars, the pip and the handle. No plate, no gradient.

    Geometry is badge-96.svg's, with its transform folded into the numbers, then
    scaled 1.10 about (32,33) and centred at (54,54) in the 108dp viewport. That
    scale is not arbitrary: the furthest point of the shape is the round cap on
    the handle tip, which lands 35.4dp from centre — inside the 36dp radius of
    the adaptive-icon safe zone, with the margin small enough that the icon
    still fills its circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="32"
        android:pivotY="33"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateX="22"
        android:translateY="21">
        <path
            android:pathData="M16.360,27.940 a17.480,17.480 0 1,0 34.960,0 a17.480,17.480 0 1,0 -34.960,0 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.06" />
