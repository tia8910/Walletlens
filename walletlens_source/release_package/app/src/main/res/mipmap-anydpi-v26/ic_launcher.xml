<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <background>
        <layer-list>
            <item android:drawable="@android:color/white" />
            <!-- 
                The paddings below give the icons a similar proportion as the
                icon generated by WebAPKs.
            -->
            <item android:drawable="@mipmap/ic_maskable"
                android:top="8.5dp"
                android:right="8.5dp"
                android:left="8.5dp"
                android:bottom="8.5dp" />
        </layer-list>
    </background>
    <foreground android:drawable="@android:color/transparent" />

    <!--
        Android 13+ themed icons. Without this layer the launcher has nothing
        to tint and simply falls back to the full-colour icon, so WalletLens
        was the one icon on a themed home screen that ignored the theme.

        Note the layers above are left exactly as PWABuilder generated them:
        the mark lives in <background> and <foreground> is transparent, which
        costs the parallax effect but is what currently ships and looks right.
        Rearranging it is a change nobody here can see the result of, and the
        themed icon does not depend on it.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
